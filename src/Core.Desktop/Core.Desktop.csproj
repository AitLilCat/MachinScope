<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><OutputType>WinExe</OutputType><UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><SelfContained>true</SelfContained><RuntimeIdentifier>win-x64</RuntimeIdentifier><ApplicationManifest>app.manifest</ApplicationManifest><ApplicationIcon>Assets/core.ico</ApplicationIcon><AssemblyName>MachinScope</AssemblyName></PropertyGroup><ItemGroup><ProjectReference Include="../Core.Windows/Core.Windows.csproj" /><ProjectReference Include="../Core.Persistence/Core.Persistence.csproj" /><PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" /><PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" /><PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" /></ItemGroup><Target Name="PublishCoreXamlResources" AfterTargets="Publish" Condition="'$(PublishSingleFile)' != 'true'">
  <ItemGroup><CoreXamlResource Include="$(TargetDir)**\*.xbf"/><CorePriResource Include="$(TargetDir)$(AssemblyName).pri"/></ItemGroup>
  <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="Compiled MachinScope resource index is missing; publish cannot produce a runnable WinUI app."/>
  <Copy SourceFiles="@(CoreXamlResource)" DestinationFiles="@(CoreXamlResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"/>
  <Copy SourceFiles="@(CorePriResource)" DestinationFolder="$(PublishDir)"/>
</Target></Project>
