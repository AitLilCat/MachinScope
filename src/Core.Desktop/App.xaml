<Application x:Class="Core.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CoreWindowBackground" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="CoreSurfaceBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CoreGraphGrid" Color="#737373" />
                    <SolidColorBrush x:Key="CoreGraphLine" Color="#0067C0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="CoreWindowBackground" Color="#000000" />
                    <SolidColorBrush x:Key="CoreSurfaceBackground" Color="#111111" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#111111" />
                    <SolidColorBrush x:Key="CoreGraphGrid" Color="#696969" />
                    <SolidColorBrush x:Key="CoreGraphLine" Color="#1E90FF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CoreWindowBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CoreSurfaceBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CoreGraphGrid" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="CoreGraphLine" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
