<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms><PlatformTarget>x64</PlatformTarget>
    <Version>0.1.0-beta</Version><AssemblyVersion>0.1.0.0</AssemblyVersion><FileVersion>0.1.0.0</FileVersion>
    <Product>MachinScope</Product><Title>MachinScope — Deep System Inspection &amp; Control</Title>
    <Description>Local-first Windows system inspection and administration</Description>
    <Company>AitLilCat</Company><Authors>AitLilCat</Authors>
    <Copyright>Copyright © 2026 AitLilCat</Copyright>
    <RepositoryUrl>https://github.com/AitLilCat/MachinScope</RepositoryUrl>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
